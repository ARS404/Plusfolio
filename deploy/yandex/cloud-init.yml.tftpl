#cloud-config
# Only for a new dedicated VM created by this module, never a shared host.
groups: [docker]
users:
  - name: plusfolio
    groups: [docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
package_update: true
packages: [ca-certificates, curl, git, python3, caddy]
disk_setup:
  /dev/disk/by-id/virtio-plusfolio-data:
    table_type: gpt
    layout: true
    overwrite: false
fs_setup:
  - device: /dev/disk/by-id/virtio-plusfolio-data
    partition: auto
    filesystem: ext4
    overwrite: false
mounts:
  - [/dev/disk/by-id/virtio-plusfolio-data-part1, /srv/plusfolio-data, ext4, 'defaults,nofail', '0', '2']
runcmd:
  - [install, -m, '0755', -d, /etc/apt/keyrings]
  - [curl, -fsSL, https://download.docker.com/linux/ubuntu/gpg, -o, /etc/apt/keyrings/docker.asc]
  - [chmod, a+r, /etc/apt/keyrings/docker.asc]
  - ['sh', '-ec', 'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list']
  - [apt-get, update]
  - [apt-get, install, -y, docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin, docker-compose-plugin]
  - [systemctl, enable, --now, docker]
  - ['sh', '-ec', 'mountpoint -q /srv/plusfolio-data && install -d -m 0700 /srv/plusfolio-data/postgres']
  - [install, -d, -o, '65532', -g, '65532', -m, '0700', /srv/plusfolio/backups]
